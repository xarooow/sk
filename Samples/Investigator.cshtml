@model sk.Samples.InvestigatorViewModel
@{
    ViewData["Title"] = "Рабочий стол следователя";
    // Layout = "_SecureInvestigatorLayout"; // Пока отключаем
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Управление заявками на поиск понятых</h2>
        <span class="badge bg-dark fs-6">Служебный доступ (СК РФ)</span>
    </div>

    <div class="card mb-5 shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0 mt-1 mb-1">Создать новую заявку</h5>
        </div>
        <div class="card-body bg-light">
            <form asp-action="CreateRequest" method="post">
                <div class="row align-items-end">
                    <div class="col-md-6 mb-3">
                        <label for="Address" class="form-label text-muted">Место проведения (Адрес или координаты)</label>
                        <input type="text" class="form-control" id="Address" name="Address" placeholder="Например: ул. Пушкина, д. 10" required>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="RequiredPeople" class="form-label text-muted">Количество понятых</label>
                        <input type="number" class="form-control" id="RequiredPeople" name="RequiredPeople" min="1" max="10" value="2" required>
                    </div>
                    <div class="col-md-3 mb-3">
                        <button type="submit" class="btn btn-success w-100">Опубликовать</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <h4 class="mb-3">Активные запросы</h4>
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-hover mb-0 bg-white">
            <thead class="table-light">
                <tr>
                    <th class="text-center">ID</th>
                    <th>Местоположение</th>
                    <th class="text-center">Отклики</th>
                    <th>Статус</th>
                    <th class="text-center">Действия</th>
                </tr>
            </thead>
            <tbody class="align-middle">
                @foreach (var req in Model.ActiveRequests)
                {
                    <tr>
                        <td class="text-center fw-bold text-muted">#@req.Id</td>
                        <td>@req.Address</td>
                        <td class="text-center">
                            <span class="fs-5 fw-bold">@req.RespondedCount</span> / @req.RequiredCount
                        </td>
                        <td>
                            @if (req.RespondedCount >= req.RequiredCount)
                            {
                                <span class="badge bg-success px-3 py-2">Люди найдены</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-3 py-2">Ожидание откликов</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="ManageRequest" asp-route-id="@req.Id" class="btn btn-sm btn-outline-primary me-2">Выбрать</a>
                            @if (req.RespondedCount >= req.RequiredCount)
                            {
                                <form asp-action="GenerateProtocol" asp-route-id="@req.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-primary">📄 Протокол</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" disabled>📄 Протокол</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>